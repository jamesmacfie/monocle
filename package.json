{
  "name": "monocle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "type": "module",
  "main": "index.js",
  "paths": {
    "@/*": [
      "./content/*"
    ]
  },
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "tsc --noEmit && wxt build",
    "build:zip": "tsc --noEmit && wxt zip",
    "build:firefox": "tsc --noEmit && wxt build -b firefox --mv3",
    "build:firefox:zip": "tsc --noEmit && wxt zip -b firefox --mv3",
    "clean": "wxt clean",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "tsc --noEmit",
    "fmt": "biome check --write --unsafe",
    "fmt:check": "biome check",
    "server": "node server/index.js"
  },
  "keywords": [],
  "author": "James Macfie",
  "license": "PolyForm Noncommercial License 1.0.0",
  "description": "A browser extension that adds a command palette interface to any webpage",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@reduxjs/toolkit": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "express": "^5.1.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-select": "^5.10.2",
    "tailwind-merge": "^3.6.0",
    "ts-pattern": "^5.8.0",
    "uuid": "^13.0.0",
    "wouter": "^3.10.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.0.13",
    "@types/react-dom": "^19.1.9",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "linkedom": "0.18.12",
    "tailwindcss": "^4.1.13",
    "typescript": "5.9.2",
    "vitest": "^4.1.8",
    "wxt": "^0.20.26"
  }
}
