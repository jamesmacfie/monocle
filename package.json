{
  "name": "monocle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:chrome": "turbo run dev:chrome",
    "dev:firefox": "turbo run dev:firefox",
    "build": "turbo run build",
    "build:firefox": "turbo run build:firefox",
    "dev:bridge": "turbo run dev:bridge",
    "build:bridge": "turbo run build:bridge",
    "test": "turbo run test",
    "tsc": "turbo run tsc",
    "fmt": "pnpm --filter @monocle/extension fmt",
    "fmt:check": "pnpm --filter @monocle/extension fmt:check"
  },
