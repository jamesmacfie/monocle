{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".output/**"] },
    "build:firefox": { "dependsOn": ["^build"], "outputs": [".output/**"] },
    "build:zip": { "dependsOn": ["^build"], "outputs": [".output/**"] },
    "build:firefox:zip": { "dependsOn": ["^build"], "outputs": [".output/**"] },
    "test": { "dependsOn": ["^build"] },
    "tsc": {},
    "dev": { "cache": false, "persistent": true },
    "dev:chrome": { "cache": false, "persistent": true },
    "dev:firefox": { "cache": false, "persistent": true },
    "dev:bridge": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "MONOCLE_CHROME_EXTENSION_ID",
        "MONOCLE_BRIDGE_PORT",
        "MONOCLE_BRIDGE_HEADLESS"
      ]
    },
    "build:bridge": {
      "outputs": ["src-tauri/target/release/bundle/**"],
      "passThroughEnv": ["MONOCLE_CHROME_EXTENSION_ID", "MONOCLE_BRIDGE_PORT"]
    }
  }
}
